QMainWindow {
    background: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 10pt;
}

QDialog {
    background-color: #161b22;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 10pt;
    border: 1px solid #30363d;
}

QGroupBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    font-weight: 600;
    color: #e6edf3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top-left;
    padding: 0 6px;
    margin-left: 8px;
}

QLabel {
    color: #e6edf3;
}

QLineEdit, QDoubleSpinBox, QSpinBox {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #58a6ff;
    selection-color: #0d1117;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #58a6ff;
}

QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 5px 10px;
    color: #e6edf3;
}

QPushButton:hover {
    background-color: #30363d;
}

QPushButton:pressed {
    background-color: #1f6feb;
}

QPushButton#primary {
    background-color: #238636;
    border-color: #238636;
    color: #e6edf3;
}

QPushButton#primary:hover {
    background-color: #2ea043;
}

QPushButton#danger {
    background-color: #f85149;
    border-color: #f85149;
    color: #0d1117;
}

QPushButton#danger:hover {
    background-color: #da3633;
}

QPushButton#secondary {
    background-color: #21262d;
    border: 1px solid #30363d;
    color: #e6edf3;
}

QPushButton#secondary:hover {
    background-color: #30363d;
}

QPushButton#secondary:pressed {
    background-color: #484f58;
}

QPushButton:disabled {
    background-color: #161b22;
    border-color: #30363d;
    color: #6e7681;
}

QTableWidget {
    background-color: #0d1117;
    alternate-background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    gridline-color: #30363d;
    selection-background-color: #1f6feb;
    selection-color: #e6edf3;
}

QHeaderView::section {
    background-color: #161b22;
    color: #e6edf3;
    padding: 4px 6px;
    border: 1px solid #30363d;
    font-weight: 600;
}

QTableView::item:hover {
    background-color: #161b22;
}

QToolBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
    spacing: 6px;
    padding: 4px 8px;
}

QToolButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #30363d;
}

QToolButton:pressed {
    background-color: #1f6feb;
}

QDockWidget::title {
    background-color: #161b22;
    border: 1px solid #30363d;
    padding: 4px 6px;
    font-weight: 600;
}

QToolBar::tab {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-bottom: none;
    padding: 5px 10px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0d1117;
    color: #e6edf3;
}

QSplitter::handle {
    background-color: #161b22;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QStatusBar {
    background-color: #161b22;
    border-top: 1px solid #30363d;
    color: #8b949e;
}

QScrollBar:vertical {
    background-color: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background-color: #0d1117;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    border: none;
}